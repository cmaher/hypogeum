# Optional local overrides; these match the development Compose defaults.
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
MIGRATION_PASSWORD=password
USERS_PASSWORD=password
TASKS_PASSWORD=password
MIGRATION_DATABASE_URL=postgres://foundation_migrator:password@127.0.0.1:5432/foundation
USERS_DATABASE_URL=postgres://foundation_users:password@127.0.0.1:5432/foundation
TASKS_DATABASE_URL=postgres://foundation_tasks:password@127.0.0.1:5432/foundation
USERS_BIND=127.0.0.1:50051
TASKS_BOARD_BIND=127.0.0.1:8082
TASKS_SHUTDOWN_SECONDS=30
