# Optional local overrides; these match the development Compose defaults.
HYPOGEUM_POSTGRES_PASSWORD=password
HYPOGEUM_POSTGRES_PORT=5432
HYPOGEUM_MIGRATION_PASSWORD=password
HYPOGEUM_USERS_PASSWORD=password
HYPOGEUM_TASKS_PASSWORD=password
HYPOGEUM_MIGRATION_DATABASE_URL=postgres://hypogeum_migrator:password@127.0.0.1:5432/hypogeum
HYPOGEUM_USERS_DATABASE_URL=postgres://hypogeum_users:password@127.0.0.1:5432/hypogeum
HYPOGEUM_TASKS_DATABASE_URL=postgres://hypogeum_tasks:password@127.0.0.1:5432/hypogeum
HYPOGEUM_USERS_BIND=127.0.0.1:50051
HYPOGEUM_TASKS_BOARD_BIND=127.0.0.1:8082
HYPOGEUM_TASKS_SHUTDOWN_SECONDS=30
HYPOGEUM_LOG=info
HYPOGEUM_WEB_BIND=127.0.0.1:8080
