# Optional local overrides; these match the development Compose defaults.
APP_POSTGRES_PASSWORD=password
APP_POSTGRES_PORT=5432
APP_MIGRATION_PASSWORD=password
APP_USERS_PASSWORD=password
APP_TASKS_PASSWORD=password
APP_MIGRATION_DATABASE_URL=postgres://foundation_migrator:password@127.0.0.1:5432/foundation
APP_USERS_DATABASE_URL=postgres://foundation_users:password@127.0.0.1:5432/foundation
APP_TASKS_DATABASE_URL=postgres://foundation_tasks:password@127.0.0.1:5432/foundation
APP_USERS_BIND=127.0.0.1:50051
APP_TASKS_BOARD_BIND=127.0.0.1:8082
APP_TASKS_SHUTDOWN_SECONDS=30
APP_LOG=info
