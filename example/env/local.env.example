# Optional local overrides; these match the development Compose defaults.
EXEMPLUM_POSTGRES_PASSWORD=password
EXEMPLUM_POSTGRES_PORT=5432
EXEMPLUM_MIGRATION_PASSWORD=password
EXEMPLUM_USERS_PASSWORD=password
EXEMPLUM_TASKS_PASSWORD=password
EXEMPLUM_KRATOS_DB_PASSWORD=password
# Kratos secrets: cookie secret at least 16 characters; cipher secret exactly 32.
EXEMPLUM_KRATOS_COOKIE_SECRET=exemplum-local-cookie-secret-0123456789
EXEMPLUM_KRATOS_CIPHER_SECRET=local-cipher-secret-0123456789ab
EXEMPLUM_MIGRATION_DATABASE_URL=postgres://exemplum_migrator:password@127.0.0.1:5432/exemplum
EXEMPLUM_USERS_DATABASE_URL=postgres://exemplum_users:password@127.0.0.1:5432/exemplum
EXEMPLUM_TASKS_DATABASE_URL=postgres://exemplum_tasks:password@127.0.0.1:5432/exemplum
EXEMPLUM_USERS_BIND=127.0.0.1:50051
EXEMPLUM_LOG=info
EXEMPLUM_LOG_FORMAT=text
# The app listens behind Caddy; browse http://localhost:8080.
EXEMPLUM_APP_BIND=127.0.0.1:3000
EXEMPLUM_APP_DATABASE_URL=postgres://exemplum_users:password@127.0.0.1:5432/exemplum
# Kratos public API as reached by the app, and as reached by browsers via Caddy.
EXEMPLUM_APP_KRATOS_PUBLIC_URL=http://127.0.0.1:4433
EXEMPLUM_APP_KRATOS_BROWSER_URL=http://localhost:8080/.ory/kratos
